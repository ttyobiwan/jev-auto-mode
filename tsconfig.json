{
	"compilerOptions": {
		"target": "es2022",
		"module": "esnext",
		"moduleResolution": "bundler",
		"jsx": "preserve",
		"jsxImportSource": "@opentui/solid",
		"lib": ["es2022"],
		"types": ["node", "bun-types"],
		"strict": true,
		"noEmit": true,
		"skipLibCheck": true
	},
	"include": ["**/*.ts", "**/*.tsx"],
	"exclude": ["node_modules"]
}
